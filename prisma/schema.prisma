// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./database/database.db"
}

model User {
  id String @id
  username String
  roomCode String
  room Room @relation(fields: [roomCode], references: [roomCode], onDelete: Cascade)
}

model Room {
  roomCode String @id 
  users User[]
}